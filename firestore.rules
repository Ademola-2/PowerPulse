rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /energy_profiles/{profileId} {
      // A signed-in user can read only profiles they own.
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // New profiles must be assigned to the signed-in user's UID.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Owners can edit their profiles, but cannot transfer ownership.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;

      // Only the owner can delete a profile.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }
  }
}
